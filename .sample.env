# ============================================================
# Zobber AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .sample.env .env
# ============================================================


# ------------------------------------------------------------
# OpenRouter API
# Get your key at: https://openrouter.ai/settings/keys
# ------------------------------------------------------------
OPENROUTER_API_TOKEN=your_openrouter_api_key_here

# Jev System One decision model (Phase 2/3 classification)
# Default: typesafe/jev-1.13  |  Alias: ~typesafe/jev-latest
JEV_MODEL=typesafe/jev-1.13

# Generative model for personalized email writing (Phase 3)
# Default: openai/gpt-4o-mini
OPENROUTER_GENERATIVE_MODEL=openai/gpt-4o-mini


# ------------------------------------------------------------
# GitHub API
# Optional — but STRONGLY recommended to avoid rate limiting.
# Create a Personal Access Token (PAT) at:
# https://github.com/settings/tokens  (no scopes needed for public data)
# ------------------------------------------------------------
GITHUB_TOKEN=your_github_personal_access_token_here


# ------------------------------------------------------------
# Search Configuration (Phase 1)
# Comma-separated queries to run against GitHub search.
# Example: "founder,cto,vp engineering,head of hr"
# ------------------------------------------------------------
SEARCH_QUERY=founder


# ------------------------------------------------------------
# SMTP Mailer Settings (Phase 4 — Nodemailer)
# ------------------------------------------------------------

# Your SMTP server host
SMTP_HOST=smtp.gmail.com

# SMTP port — 587 (STARTTLS) or 465 (SSL)
SMTP_PORT=587

# Set to "true" only when using port 465 (SSL/TLS)
SMTP_SECURE=false

# The email account used to authenticate with the SMTP server
SMTP_USER=your_email@gmail.com

# For Gmail: use an App Password (not your account password).
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your_app_password_here

# The "From" header displayed to the recipient
EMAIL_FROM="Zobber AI Outreach <your_email@gmail.com>"

# Delay in milliseconds between each outgoing email (throttle).
# Set higher to reduce spam-score risk. Minimum recommended: 2000
EMAIL_THROTTLE_MS=3000
